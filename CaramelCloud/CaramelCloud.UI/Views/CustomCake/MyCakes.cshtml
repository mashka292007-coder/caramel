@using CaramelCloud.UI.Models.CustomCake
@model IEnumerable<CustomCakeViewModel>
@{
    ViewData["Title"] = "Мої торти";

    string GetFlavorColor(string name, bool isSponge)
    {
        if (string.IsNullOrEmpty(name)) return isSponge ? "#F7E4A0" : "#FEFCF0";
        var lower = name.ToLower();
        if (lower.Contains("шоколад")) return "#5C3A21";
        if (lower.Contains("карамел")) return "#D49A59";
        if (lower.Contains("малин") || lower.Contains("полуниц")) return "#E8607A";
        if (lower.Contains("вишн")) return "#8B0000";
        if (lower.Contains("фісташ")) return "#A6C36F";
        if (lower.Contains("ваніл")) return isSponge ? "#FDF5D3" : "#FEFCF0";
        if (lower.Contains("лимон")) return "#FFF44F";
        if (lower.Contains("чорниц") || lower.Contains("смородин")) return "#665C84";
        if (lower.Contains("манго") || lower.Contains("маракуй") || lower.Contains("апельсин")) return "#F4A460";
        return isSponge ? "#F7E4A0" : "#FEFCF0";
    }
}

<div class="container-fluid pt-4 px-4 pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 style="font-family:'Cormorant Garamond',serif;font-size:2rem;color:#171717;margin:0;">
                Мої торти
            </h2>
            <p style="color:#6B6B6B;font-size:.875rem;margin:.25rem 0 0;">
                Ваші збережені конфігурації
            </p>
        </div>
        <a asp-action="Build" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Створити новий
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="cc-form-card text-center py-5">
            <i class="bi bi-cake2" style="font-size:3rem;color:#D3D1C7;
            display:block;margin-bottom:1rem;"></i>
            <p style="color:#6B6B6B;margin-bottom:1.5rem;">
                У вас ще немає збережених тортів
            </p>
            <a asp-action="Build" class="btn btn-primary px-5">
                <i class="bi bi-magic me-2"></i>Створити перший торт
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cake in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="cc-form-card h-100" style="display:flex;flex-direction:column;">

                        <div style="display:flex;align-items:flex-start;
                            justify-content:space-between;margin-bottom:12px;">
                            <div>
                                <div style="font-family:'Cormorant Garamond',serif;
                                    font-size:1.15rem;font-weight:600;color:#171717;">
                                    @cake.Name
                                </div>
                                <div style="font-size:.75rem;color:#6B6B6B;">
                                    @cake.CreatedAt.ToString("dd.MM.yyyy") · @cake.LayerCount шари
                                </div>
                            </div>
                            <span style="font-weight:700;font-size:1.05rem;
                                color:#8B4513;white-space:nowrap;">
                                @cake.TotalPrice.ToString("N2") ₴
                            </span>
                        </div>

                        <div style="margin-bottom:14px;">
                            @for (int i = cake.Layers.Count - 1; i >= 0; i--)
                            {
                                var l = cake.Layers[i];
                                var sCol = string.IsNullOrEmpty(l.LayerImage)
                                    ? GetFlavorColor(l.LayerName, true) : null;
                                var fCol = string.IsNullOrEmpty(l.FillingImage)
                                    ? GetFlavorColor(l.FillingName, false) : null;
                                <div style="margin-bottom:1px;">
                                    @if (!string.IsNullOrEmpty(l.LayerImage))
                                    {
                                        <div style="height:22px;background:url('@l.LayerImage') center/cover;
                                        border-radius:4px 4px 0 0;"></div>
                                    }
                                    else
                                    {
                                        <div style="height:22px;background:@sCol;
                                            border-radius:4px 4px 0 0;
                                            display:flex;align-items:center;padding:0 8px;
                                            font-size:.6rem;color:rgba(255,255,255,.7);">
                                            @l.LayerName
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(l.FillingImage))
                                    {
                                        <div style="height:8px;background:url('@l.FillingImage') center/cover;
                                        border-radius:0 0 4px 4px;"></div>
                                    }
                                    else
                                    {
                                        <div style="height:8px;background:@fCol;
                                        border-radius:0 0 4px 4px;"></div>
                                    }
                                </div>
                            }
                            <div style="height:7px;background:#D3D1C7;
                            border-radius:0 0 50% 50%;"></div>
                        </div>

                        <div style="margin-bottom:14px;">
                            @foreach (var l in cake.Layers.OrderBy(x => x.LayerOrder))
                            {
                                var sCol = GetFlavorColor(l.LayerName, true);
                                var fCol = GetFlavorColor(l.FillingName, false);
                                <div style="display:flex;align-items:center;gap:.5rem;
                                    padding:.35rem 0;border-bottom:1px solid rgba(0,0,0,.04);
                                    font-size:.8rem;">
                                    <span style="width:18px;height:18px;border-radius:4px;
                                        background:rgba(139,69,19,.08);display:flex;
                                        align-items:center;justify-content:center;
                                        font-size:.65rem;font-weight:700;color:#8B4513;
                                        flex-shrink:0;">
                                        @l.LayerOrder
                                    </span>
                                    <span style="width:8px;height:8px;border-radius:2px;
                                    background:@sCol;flex-shrink:0;
                                    border:1px solid rgba(0,0,0,.08);"></span>
                                    <span style="flex:1;color:#171717;font-weight:500;">
                                        @l.LayerName
                                    </span>
                                    <span style="width:8px;height:8px;border-radius:2px;
                                    background:@fCol;flex-shrink:0;
                                    border:1px solid rgba(0,0,0,.08);"></span>
                                    <span style="color:#6B6B6B;">@l.FillingName</span>
                                </div>
                            }
                        </div>

                        <div style="margin-top:auto;display:flex;gap:8px;">
                            <a asp-action="Order" asp-route-cakeId="@cake.Id"
                                   class="btn btn-primary flex-grow-1"
                                   style="border-radius:8px;font-size:.85rem;">
                                <i class="bi bi-bag-check me-1"></i>Замовити
                            </a>
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Видалити цей торт?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@cake.Id" />
                                <button type="submit" class="btn btn-outline-danger"
                                        style="border-radius:8px;">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
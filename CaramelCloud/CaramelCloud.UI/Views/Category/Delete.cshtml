@using CaramelCloud.UI.Models.Category
@model CategoryViewModel

<div class="container-fluid pt-4 px-4 pb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 style="font-family:'Cormorant Garamond',serif; font-size:2rem; color:#171717; margin:0;">
                Видалення категорії
            </h2>
            <p style="color:#6B6B6B; font-size:.875rem; margin:.25rem 0 0;">
                Підтвердіть видалення категорії
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-primary px-4" style="border-radius:8px; font-size:.9rem;">
            <i class="bi bi-arrow-left me-2"></i>Назад до списку
        </a>
    </div>

    <div style="background:rgba(220,53,69,.06); border:1px solid rgba(220,53,69,.2);
        border-radius:1rem; padding:1.25rem 1.5rem; margin-bottom:1.5rem;
        display:flex; align-items:flex-start; gap:1rem;">
        <div style="width:44px; height:44px; border-radius:10px;
            background:rgba(220,53,69,.1); flex-shrink:0;
            display:flex; align-items:center; justify-content:center;">
            <i class="bi bi-exclamation-triangle" style="color:#dc3545; font-size:1.2rem;"></i>
        </div>
        <div>
            <div style="font-weight:600; color:#171717; font-size:.95rem; margin-bottom:.25rem;">
                Увага! Цю дію неможливо скасувати
            </div>
            <div style="color:#6B6B6B; font-size:.875rem; line-height:1.6;">
                Ви збираєтесь видалити категорію <strong style="color:#171717;">@Model.Name</strong>.
                Якщо до неї прив'язані продукти — видалення може бути заблоковано.
            </div>
        </div>
    </div>

    <div class="cc-form-card">
        <p style="font-size:.72rem; font-weight:700; text-transform:uppercase;
            letter-spacing:.07em; color:#6B6B6B; margin-bottom:1.25rem;">
            Дані категорії
        </p>

        <div style="display:flex; align-items:center; gap:1.5rem; margin-bottom:2rem;
            padding:1.25rem; background:#FAFAFA; border-radius:12px;
            border:1px solid var(--cc-border);">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name"
                     style="width:80px; height:80px; object-fit:cover;
                border-radius:12px; border:1px solid #E5E5E5; flex-shrink:0;" />
            }
            else
            {
                <div style="width:80px; height:80px; border-radius:12px;
                    background:#F5F5F5; border:1px solid #E5E5E5;
                    display:flex; align-items:center; justify-content:center;
                    flex-shrink:0; color:#A05A2C;">
                    <i class="bi bi-image" style="font-size:2rem;"></i>
                </div>
            }
            <div>
                <div style="font-weight:700; font-size:1.1rem; color:#171717;">@Model.Name</div>
                <div style="color:#6B6B6B; font-size:.875rem; margin-top:.35rem; line-height:1.6;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Опис відсутній" : Model.Description)
                </div>
            </div>
        </div>

        <div style="padding-top:1.5rem; border-top:1px solid #F5F5F5;" class="d-flex gap-3">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <button type="submit"
                        style="background:#dc3545; color:#fff; border:none;
                    border-radius:10px; padding:.6rem 2rem;
                    font-weight:600; font-size:.9375rem; cursor:pointer;
                    transition:opacity .2s;"
                        onmouseover="this.style.opacity='.85'"
                        onmouseout="this.style.opacity='1'">
                    <i class="bi bi-trash me-2"></i>Так, видалити
                </button>
            </form>
            <a asp-action="Index" class="btn btn-light px-4 py-2"
                   style="border-radius:10px; background:#F8F9FA; color:#6B6B6B; border:1px solid #E9ECEF;">
                Скасувати
            </a>
        </div>
    </div>
</div>
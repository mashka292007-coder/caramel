@using CaramelCloud.UI.Models.InventoryPurchase
@model InventoryPurchaseViewModel

@{
    ViewData["Title"] = "Видалення закупівлі";
}

<div class="container-fluid pt-4 px-4 pb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1" style="font-family:'Cormorant Garamond',serif; font-size:2.2rem; color:#171717; font-weight: 600;">
                Видалити запис закупівлі?
            </h2>
            <p class="text-muted mb-0" style="font-size: .875rem;">
                Видалення інформації з журналу операцій
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cc px-4">
            <i class="bi bi-arrow-left me-2"></i>Назад до журналу
        </a>
    </div>

    <div style="background:rgba(220,53,69,.06); border:1px solid rgba(220,53,69,.2);
        border-radius:1rem; padding:1.25rem 1.5rem; margin-bottom:1.5rem;
        display:flex; align-items:flex-start; gap:1rem;">
        <div style="width:44px; height:44px; border-radius:10px;
            background:rgba(220,53,69,.1); flex-shrink:0;
            display:flex; align-items:center; justify-content:center;">
            <i class="bi bi-exclamation-triangle" style="color:#dc3545; font-size:1.2rem;"></i>
        </div>
        <div>
            <div style="font-weight:600; color:#171717; font-size:.95rem; margin-bottom:.25rem;">
                Зверніть увагу
            </div>
            <div style="color:#6B6B6B; font-size:.875rem; line-height:1.6;">
                Видалення цього запису <strong style="color:#171717;">не знімає</strong> кількість зі складу. Видаляється лише інформація з історії закупівель.
            </div>
        </div>
    </div>

    <div class="cc-section-block">

        <div class="d-flex align-items-center mb-4 pb-3" style="border-bottom: 1px solid #F5F5F5;">
            <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; background: rgba(139,69,19,.1);">
                <i class="bi bi-journal-x text-primary fs-5"></i>
            </div>
            <div>
                <h5 class="fw-semibold text-dark m-0" style="font-family:'Cormorant Garamond',serif; font-size: 1.4rem;">
                    Деталі запису
                </h5>
                <div style="font-size:0.85rem; color:#6B6B6B;">Перевірте інформацію перед видаленням</div>
            </div>
        </div>

        <div class="row mb-4 g-4">
            <div class="col-md-4">
                <div class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">Інгредієнт</div>
                <div class="d-flex align-items-center">
                    <span class="rounded-circle me-3" style="width:10px; height:10px; background:#8B4513; box-shadow:0 0 0 4px rgba(139,69,19,.15);"></span>
                    <span class="fw-semibold text-dark fs-5" style="font-family:'Cormorant Garamond',serif;">
                        @Model.ItemName
                    </span>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">Кількість</div>
                <div class="fw-bold" style="font-size: 1.15rem; color: #171717;">
                    @Model.Quantity.ToString("N3") <span class="text-muted" style="font-size: .9rem; font-weight: 500;">@Model.Unit</span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">Дата закупівлі</div>
                <div class="text-dark fw-medium" style="font-size: 1.05rem;">
                    <i class="bi bi-calendar3 text-muted me-2"></i>@Model.PurchaseDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4 p-4" style="background: rgba(139,69,19,.05); border-radius: 16px; border: 1px solid rgba(139,69,19,.1);">
            <div class="text-uppercase fw-semibold" style="letter-spacing:1px; color:#8B4513; font-size: .85rem;">Вартість закупівлі</div>
            <div style="font-weight:700; color:#8B4513; font-size:1.75rem; font-family:'Cormorant Garamond',serif; line-height: 1;">
                @Model.TotalCost.ToString("N2") ₴
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.Id" />
            
            <div class="d-flex gap-3 justify-content-end mt-4 pt-3" style="border-top: 1px solid #F5F5F5;">
                 <a asp-action="Index" class="btn btn-light px-5 py-3 text-dark fs-6" style="border-radius: 50px; font-weight:600; border: 1px solid var(--cc-border);">
                    Скасувати
                </a>
                <button type="submit" class="btn btn-danger px-5 py-3 fs-6" style="border-radius: 50px;">
                    <i class="bi bi-trash me-2"></i>Видалити запис
                </button>
            </div>
        </form>

    </div>
</div>

<style>
    .cc-section-block {
        background: #fff;
        border: 1px solid var(--cc-border);
        border-radius: 1.25rem;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.03);
    }
    .cc-form-label {
        display: block;
        font-weight: 600;
    }
</style>
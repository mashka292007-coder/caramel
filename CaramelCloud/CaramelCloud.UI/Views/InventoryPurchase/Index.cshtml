@using CaramelCloud.UI.Models.InventoryPurchase
@model IEnumerable<InventoryPurchaseViewModel>

@{
    ViewData["Title"] = "Закупівлі";
    var warnings = ViewBag.LowStockWarnings as List<string> ?? new();
}

<div class="container-fluid pt-4 px-4 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Закупівлі</h2>
            <p class="text-muted mb-0 small">Поповнення складу сировиною та інгредієнтами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Нова закупівля
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-auto">
            <div class="cc-stat-card">
                <div class="cc-stat-icon"><i class="bi bi-wallet2"></i></div>
                <div>
                    <div class="cc-stat-value">@Model.Count()</div>
                    <div class="cc-stat-label">Всього закупівель</div>
                </div>
            </div>
        </div>
        <div class="col-auto">
            <div class="cc-stat-card cc-stat-card--active">
                <div class="cc-stat-icon cc-stat-icon--active"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="cc-stat-value">@Model.Sum(p => p.TotalCost).ToString("N0")</div>
                    <div class="cc-stat-label">Загальна сума, ₴</div>
                </div>
            </div>
        </div>
    </div>

    @if (warnings.Any())
    {
        <div class="alert cc-alert-danger d-flex align-items-center gap-3 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>
                <div class="fw-semibold">Низький залишок інгредієнтів</div>
                <div class="small">
                @string.Join(" • ", warnings.Select(w => System.Text.RegularExpressions.Regex.Replace(w, @"(,000|\.000)", "")))
            </div>
            </div>
        </div>
    }

    <div class="cc-table-wrapper">
        <div class="card-header d-flex align-items-center justify-content-between px-4 py-3">
            <span class="fw-semibold cc-serif" style="font-size:1.1rem;">Журнал операцій</span>
            <div class="cc-search-wrapper">
                <i class="bi bi-search cc-search-icon"></i>
                <input type="text" class="form-control cc-search-input"
                       placeholder="Пошук за назвою чи постачальником..." onkeyup="filterTable(this.value)">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table cc-table align-middle mb-0" id="purchasesTable">
                <thead>
                    <tr>
                        <th>Інгредієнт</th>
                        <th style="width:130px;">Кількість</th>
                        <th style="width:120px;">Ціна / од.</th>
                        <th style="width:130px;">Сума</th>
                        <th style="width:160px;">Постачальник</th>
                        <th style="width:150px;">Дата</th>
                        <th class="text-end" style="width:100px;">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="cc-status-dot cc-status-dot--primary"></span>
                                    <span class="fw-semibold text-dark">@p.ItemName</span>
                                </div>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@p.Quantity.ToString("0.###")</span>
                                <span class="text-muted ms-1" style="font-size:.85rem;">@p.Unit</span>
                            </td>
                            <td class="text-muted">@p.PricePerUnit.ToString("N2") ₴</td>
                            <td><span class="fw-bold text-cc-primary">@p.TotalCost.ToString("N2") ₴</span></td>
                            <td class="text-muted">@(string.IsNullOrEmpty(p.Supplier) ? "—" : p.Supplier)</td>
                            <td class="text-muted" style="font-size:.85rem;">
                                @p.PurchaseDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <a asp-action="Delete" asp-route-id="@p.Id" class="cc-btn-table delete">Видалити</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-cart-x fs-2 d-block mb-2" style="color:var(--cc-border);"></i>
                                <span class="cc-serif d-block mb-1" style="font-size:1.1rem; color:#171717;">Журнал закупівель порожній</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterTable(val) {
            const rows = document.querySelectorAll('#purchasesTable tbody tr');
            const q = val.toLowerCase();
            rows.forEach(r => {
                if (r.cells.length === 1) return;
                r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}

@section Styles {
<style>
    .cc-status-dot {
        width: 8px; height: 8px; border-radius: 50%;
        flex-shrink: 0; display: inline-block;
    }
    .cc-status-dot--primary { background: var(--cc-primary); box-shadow: 0 0 0 3px rgba(139,69,19,.15); }
</style>
}

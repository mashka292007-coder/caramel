@using CaramelCloud.UI.Models.InventoryPurchase
@model CreateInventoryPurchaseViewModel

@{
    ViewData["Title"] = "Нова закупівля";
}

<div class="container-fluid pt-4 px-4 pb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1" style="font-family:'Cormorant Garamond',serif; font-size:2.2rem; color:#171717; font-weight: 600;">
                Нова закупівля
            </h2>
            <p class="text-muted mb-0" style="font-size: .875rem;">
                Після збереження залишок на складі поповниться автоматично
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-cc px-4">
            <i class="bi bi-arrow-left me-2"></i>Назад до журналу
        </a>
    </div>

    <div class="cc-section-block">
        <form method="post">
            @Html.AntiForgeryToken()

            <div class="d-flex align-items-center mb-4 pb-3" style="border-bottom: 1px solid #F5F5F5;">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px; background: rgba(139,69,19,.1);">
                    <i class="bi bi-box-seam text-primary fs-5"></i>
                </div>
                <div>
                    <h5 class="fw-semibold text-dark m-0" style="font-family:'Cormorant Garamond',serif; font-size: 1.4rem;">
                        Деталі закупівлі
                    </h5>
                    <div style="font-size:0.85rem; color:#6B6B6B;">Вкажіть інгредієнт, кількість та вартість</div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="InventoryItemId" class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">
                    Інгредієнт <span class="text-danger">*</span>
                </label>
                <select asp-for="InventoryItemId" asp-items="Model.InventoryItems" class="form-select cursor-pointer" style="border-radius:12px; padding:.85rem 1rem; border:1px solid var(--cc-border);">
                    <option value="">— Оберіть інгредієнт із бази —</option>
                </select>
                <span asp-validation-for="InventoryItemId" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Quantity" class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">
                        Кількість <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Quantity" class="form-control" step="0.001" placeholder="0.000" oninput="calcTotal()" style="border-radius:12px; padding:.85rem 1rem; border:1px solid var(--cc-border);" />
                    <span asp-validation-for="Quantity" class="text-danger small mt-1 d-block"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="PricePerUnit" class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">
                        Ціна за одиницю <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <input asp-for="PricePerUnit" class="form-control" step="0.01" placeholder="0.00" oninput="calcTotal()" style="border-radius:12px 0 0 12px; padding:.85rem 1rem; border:1px solid var(--cc-border); border-right:none;" />
                        <span class="input-group-text" style="background: transparent; border-radius: 0 12px 12px 0; border: 1px solid var(--cc-border); border-left: none; color: #6B6B6B; font-weight: 500; padding: 0 1.25rem;">₴</span>
                    </div>
                    <span asp-validation-for="PricePerUnit" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Supplier" class="cc-form-label text-muted small text-uppercase" style="letter-spacing:1px; margin-bottom:.5rem;">
                    Постачальник
                </label>
                <input asp-for="Supplier" class="form-control" placeholder="Назва постачальника (необов'язково)" style="border-radius:12px; padding:.85rem 1rem; border:1px solid var(--cc-border);" />
                <span asp-validation-for="Supplier" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2 mb-4 p-4" style="background: rgba(139,69,19,.05); border-radius: 16px; border: 1px solid rgba(139,69,19,.1);">
                <div class="text-uppercase fw-semibold" style="letter-spacing:1px; color:#8B4513; font-size: .85rem;">Загальна вартість</div>
                <div id="total-display" style="font-weight:700; color:#8B4513; font-size:1.75rem; font-family:'Cormorant Garamond',serif; line-height: 1;">
                    0.00 ₴
                </div>
            </div>

            <div style="padding-top:1.5rem; border-top:1px solid #F5F5F5;" class="d-flex gap-3 justify-content-end">
                <a asp-action="Index" class="btn btn-light px-5 py-3 text-dark fs-6" style="border-radius: 50px; font-weight:600; border: 1px solid var(--cc-border);">
                    Скасувати
                </a>
                <button type="submit" class="btn btn-primary px-5 py-3 fs-6" style="border-radius: 50px;">
                    <i class="bi bi-check-circle me-2"></i>Зберегти закупівлю
                </button>
            </div>
            
        </form>
    </div>
</div>

<style>
    .cc-section-block {
        background: #fff;
        border: 1px solid var(--cc-border);
        border-radius: 1.25rem;
        padding: 2.5rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.03);
    }
    .cc-form-label {
        display: block;
        font-weight: 600;
    }
    .form-control:focus, .form-select:focus {
        border-color: #8B4513;
        box-shadow: 0 0 0 3px rgba(139,69,19,0.1);
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function calcTotal() {
            const qty   = parseFloat(document.getElementById('Quantity').value) || 0;
            const price = parseFloat(document.getElementById('PricePerUnit').value) || 0;
            const el    = document.getElementById('total-display');
            
            el.textContent = (qty > 0 && price > 0) ? (qty * price).toFixed(2) + ' ₴' : '0.00 ₴';
        }
        
        document.addEventListener('DOMContentLoaded', calcTotal);
    </script>
}
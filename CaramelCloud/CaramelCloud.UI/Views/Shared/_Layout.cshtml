@using System.Security.Claims
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — CaramelCloud</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&family=Cormorant+Garamond:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/caramel.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <nav class="navbar navbar-expand-lg cc-navbar fixed-top">
        <div class="container-fluid px-4">
            <a class="navbar-brand cc-brand d-inline-flex align-items-center gap-2 lh-1"
                   asp-controller="Home" asp-action="Index">
                <img src="~/images/logo_new.svg" height="42" alt="CaramelCloud" style="display:block;">
                Caramel<span>Cloud</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Меню">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
            
                <ul class="navbar-nav mx-lg-auto mb-2 mb-lg-0">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Головна
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
                                   asp-controller="Order" asp-action="Index">
                                <i class="bi bi-bag-heart me-1"></i>Замовлення
                            </a>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-grid me-1"></i>Каталог
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                        <i class="bi bi-grid me-1"></i>Категорії
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Product" asp-action="Index">
                                        <i class="bi bi-cake2 me-1"></i>Продукти
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="CakeLayerType" asp-action="Index">
                                        <i class="bi bi-layers me-1"></i>Типи коржів
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="CakeFillingType" asp-action="Index">
                                        <i class="bi bi-droplet-half me-1"></i>Начинки
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-box-seam me-1"></i>Склад
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="InventoryItem" asp-action="Index">
                                        <i class="bi bi-box-seam me-1"></i>Склад інгредієнтів
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="InventoryPurchase" asp-action="Index">
                                        <i class="bi bi-cart-check me-1"></i>Закупівлі
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Recipe" asp-action="Index">
                                        <i class="bi bi-journal-text me-1"></i>Рецепти
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="RecipeIngredient" asp-action="Index">
                                        <i class="bi bi-list-check me-1"></i>Інгредієнти рецептів
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")"
                                   asp-controller="Employee" asp-action="Index">
                                <i class="bi bi-people me-1"></i>Персонал
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "InstagramThreads" ? "active" : "")"
                                   asp-controller="InstagramThreads" asp-action="Create">
                                <i class="bi bi-infinity me-1" style="color: #0081FB"></i>Пост в Meta
                            </a>
                        </li>

                        <li class="nav-item d-flex align-items-center">
                            <a href="/swagger" target="_blank"
                                   style="background:rgba(139,69,19,.1); color:#6E3510; border:1px solid rgba(139,69,19,.3); border-radius:8px; font-size:.8rem; font-weight:600; padding:.35rem .85rem; text-decoration:none; transition:all .18s; white-space:nowrap; display: inline-flex; align-items: center; line-height: 1;"
                                   onmouseover="this.style.background='#8B4513';this.style.color='#fff'"
                                   onmouseout="this.style.background='rgba(139,69,19,.1)';this.style.color='#6E3510'">
                                <i class="bi bi-code-slash me-1"></i>API
                            </a>
                        </li>
                    }

                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Product" ? "active" : "")"
                                   asp-controller="Product" asp-action="Index">
                                <i class="bi bi-cake2 me-1"></i>Продукти
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")"
                                   asp-controller="Order" asp-action="Index">
                                <i class="bi bi-bag me-1"></i>Мої замовлення
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomCake" && ViewContext.RouteData.Values["action"]?.ToString() != "MyCakes" ? "active" : "")"
                                   asp-controller="CustomCake" asp-action="Build">
                                <i class="bi bi-magic me-1"></i>Конструктор торта
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CustomCake" && ViewContext.RouteData.Values["action"]?.ToString() == "MyCakes" ? "active" : "")"
                                   asp-controller="CustomCake" asp-action="MyCakes">
                                <i class="bi bi-collection me-1"></i>Мої торти
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.IsInRole("Customer"))
                    {
                        <li class="nav-item me-2">
                            <a asp-controller="Cart" asp-action="Index"
                                   style="position:relative; display:flex; align-items:center; justify-content:center; width:38px; height:38px; border-radius:50%; background:rgba(139,69,19,.08); color:#8B4513; text-decoration:none; transition:background .2s;"
                                   onmouseover="this.style.background='rgba(139,69,19,.15)'"
                                   onmouseout="this.style.background='rgba(139,69,19,.08)'">
                                <i class="bi bi-cart3" style="font-size:1.1rem;"></i>
                                <span class="cc-cart-badge" style="display:none; position:absolute; top:-4px; right:-4px; width:18px; height:18px; border-radius:50%; background:#8B4513; color:#fff; font-size:.65rem; font-weight:700; align-items:center; justify-content:center; border:2px solid #fff;">0</span>
                            </a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @User.FindFirst(ClaimTypes.GivenName)?.Value
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-1">Admin</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                        <i class="bi bi-person me-1"></i>Мій профіль
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post" style="display:inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-1"></i>Вийти
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Вхід
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="nav-link btn btn-sm btn-outline-warning px-3" asp-controller="Auth" asp-action="Register">
                                Реєстрація
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

        @if (TempData["Success"] != null)
        {
            <div class="container-fluid px-4 pt-3">
                <div class="alert cc-alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="container-fluid px-4 pt-3">
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="container-fluid px-4 pt-3">
                <div class="alert cc-alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="container-fluid px-4 pt-3">
                <div class="alert cc-alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        <main class="cc-main">
            @RenderBody()
        </main>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>